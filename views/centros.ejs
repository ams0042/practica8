<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Centros y Cursos</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1>Listado de Centros y Cursos</h1>
    <table>
        <tr>
            <th>Centro</th>
            <th>Cursos Impartidos</th>
        </tr>
        <% centros.forEach(centro => { %>
        <tr>
            <td><%= centro.centro %></td>
            <td><%= centro.cursos %></td>
        </tr>
        <% }); %>
    </table>
    <br>
    <a href="/">Volver al inicio</a>
</body>
</html>
